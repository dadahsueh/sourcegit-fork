<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="38"
             x:Class="SourceGit.Views.WelcomeToolbar"
             x:DataType="vm:Welcome">
  <UserControl.Styles>
    <Style Selector="Button.fluent_command">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.fluent_command:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
    </Style>
    <Style Selector="Button.fluent_command:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.Background}"/>
    </Style>
    <Style Selector="Button.fluent_command TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.fluent_command Path">
      <Setter Property="Fill" Value="{DynamicResource Brush.FG1}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*,Auto" Height="38" Margin="8,0">
    <!-- Left: Primary Git / Repository Actions with Labels -->
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
      <!-- 1. Clone Repository -->
      <Button Classes="fluent_command" Command="{Binding Clone}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.Clone}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+R, macOS=⌘+R}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Clone}" Margin="0,1,0,0"/>
          <TextBlock Text="{DynamicResource Text.Welcome.Clone}"/>
        </StackPanel>
      </Button>

      <!-- 2. Open Local Repository -->
      <Button Classes="fluent_command" Command="{Binding OpenLocalRepository}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.OpenOrInit}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+L, macOS=⌘+L}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Folder.Open}"/>
          <TextBlock Text="{DynamicResource Text.Welcome.OpenOrInit}"/>
        </StackPanel>
      </Button>

      <!-- Divider -->
      <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Border0}" Margin="4,0"/>

      <!-- 3. Terminal -->
      <Button Classes="fluent_command" Command="{Binding OpenTerminal}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.OpenTerminal}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+`, macOS=Λ+`}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Terminal}"/>
          <TextBlock Text="{DynamicResource Text.Welcome.OpenTerminal}"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Right: Organization & Management Actions with Labels -->
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
      <!-- 4. Create Group -->
      <Button Classes="fluent_command" Command="{Binding AddRootNode}">
        <ToolTip.Tip>
          <TextBlock Text="{DynamicResource Text.Welcome.AddRootFolder}"/>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Folder.Add}"/>
          <TextBlock Text="{DynamicResource Text.Welcome.AddRootFolder}"/>
        </StackPanel>
      </Button>

      <!-- 5. Scan Repositories -->
      <Button Classes="fluent_command" Command="{Binding ScanDefaultCloneDir}">
        <ToolTip.Tip>
          <TextBlock Text="{DynamicResource Text.Welcome.ScanDefaultCloneDir}"/>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Scan}"/>
          <TextBlock Text="{DynamicResource Text.ScanRepositories}"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
