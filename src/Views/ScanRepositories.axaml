<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="544" d:DesignHeight="450"
             x:Class="SourceGit.Views.ScanRepositories"
             x:DataType="vm:ScanRepositories">
  <StackPanel Orientation="Vertical" Margin="8,0,0,0">
    <!-- Header -->
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16"
            Data="{StaticResource Icons.Scan}"/>

      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.ScanRepositories}"/>
    </StackPanel>

    <!-- Directories to scan -->
    <Grid Margin="0,16,0,0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0"
                 VerticalAlignment="Center"
                 Text="{DynamicResource Text.ScanRepositories.Directories}"/>

      <Button Grid.Row="0" Grid.Column="1"
              Classes="flat"
              Height="24" Padding="8,0"
              Click="OnAddDirectory">
        <StackPanel Orientation="Horizontal">
          <Path Width="12" Height="12" VerticalAlignment="Center" Data="{StaticResource Icons.Folder.Add}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Text.ScanRepositories.AddDirectory}"/>
        </StackPanel>
      </Button>

      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
              Margin="0,8,0,0" Padding="8,4"
              CornerRadius="4"
              BorderThickness="1" BorderBrush="{DynamicResource Brush.Border0}"
              Background="{DynamicResource Brush.Contents}"
              IsVisible="{Binding HasDirs}">
        <ScrollViewer MaxHeight="120"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Dirs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="m:ScanDir">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2,0,2">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Recursive, Mode=TwoWay}"
                            Click="OnToggleRecursive"
                            ToolTip.Tip="{DynamicResource Text.ScanRepositories.Recursive}"/>

                  <Path Grid.Column="1"
                        Width="14" Height="14"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Data="{StaticResource Icons.Folder}"
                        Fill="{DynamicResource Brush.FG2}"/>

                  <TextBlock Grid.Column="2"
                             Margin="4,0,0,0"
                             VerticalAlignment="Center"
                             Text="{Binding Path}"
                             TextTrimming="CharacterEllipsis"/>

                  <Path Grid.Column="2"
                        Width="12" Height="12"
                        Margin="4,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Data="{StaticResource Icons.Error}"
                        Fill="Orange"
                        ToolTip.Tip="{DynamicResource Text.ScanRepositories.NotExists}"
                        IsVisible="{Binding !IsValid}"/>

                  <Button Grid.Column="3"
                          Classes="icon_button"
                          Width="24" Height="24"
                          Margin="4,0,0,0"
                          Click="OnRemoveDirectory"
                          Tag="{Binding}">
                    <Path Width="10" Height="10" Data="{StaticResource Icons.Close}" Fill="{DynamicResource Brush.FG1}"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="{DynamicResource Text.ScanRepositories.NoDirectories}"
                 IsVisible="{Binding !HasDirs}"/>
    </Grid>

    <!-- Result of the scan -->
    <Border Margin="0,16,0,0" Padding="12,8,12,12"
            CornerRadius="4"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border0}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding HasResult}">
      <StackPanel Orientation="Vertical">
        <!-- Summary -->
        <StackPanel Orientation="Horizontal" Spacing="18">
          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.ScanRepositories.Found}"/>
            <TextBlock Margin="6,0,0,0" Classes="bold" Text="{Binding FoundCount}"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.ScanRepositories.New}"/>
            <TextBlock Margin="6,0,0,0" Classes="bold" Text="{Binding NewCount}"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.ScanRepositories.Removed}"/>
            <TextBlock Margin="6,0,0,0" Classes="bold" Text="{Binding RemovedCount}"/>
          </StackPanel>
        </StackPanel>

        <!-- How to apply the result -->
        <TextBlock Margin="0,12,0,0"
                   Classes="bold"
                   Text="{DynamicResource Text.ScanRepositories.ApplyMode}"/>

        <RadioButton GroupName="ScanApplyMode"
                     Margin="0,8,0,0"
                     IsChecked="{Binding IsKeepStructure, Mode=TwoWay}">
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.ScanRepositories.KeepStructure}"/>
            <TextBlock Margin="0,2,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{DynamicResource Text.ScanRepositories.KeepStructure.Tips}"/>
          </StackPanel>
        </RadioButton>

        <RadioButton GroupName="ScanApplyMode"
                     Margin="0,8,0,0"
                     IsChecked="{Binding IsReplaceStructure, Mode=TwoWay}">
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.ScanRepositories.ReplaceStructure}"/>
            <TextBlock Margin="0,2,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{DynamicResource Text.ScanRepositories.ReplaceStructure.Tips}"/>
          </StackPanel>
        </RadioButton>

        <!-- Rescan -->
        <Button Classes="flat"
                Margin="0,12,0,0"
                Padding="8,0" Height="24"
                HorizontalAlignment="Right"
                Click="OnRescan">
          <StackPanel Orientation="Horizontal">
            <Path Width="12" Height="12" VerticalAlignment="Center" Data="{StaticResource Icons.Scan}" Fill="{DynamicResource Brush.FG1}"/>
            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Text.ScanRepositories.Rescan}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
