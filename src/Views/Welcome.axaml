<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:SourceGit.Converters"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="SourceGit.Views.Welcome"
             x:DataType="vm:Welcome">
  <UserControl.Styles>
    <!-- Sleek Fluent 2 Tree Expander Chevron -->
    <Style Selector="ToggleButton.tree_expander">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <Path x:Name="ChevronPath"
                  Data="M 5 2 L 10 7 L 5 12"
                  Stroke="{DynamicResource Brush.FG2}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
      </Style>
      <Style Selector="^:checked /template/ Path#ChevronPath">
        <Setter Property="Data" Value="M 2 5 L 7 10 L 12 5" />
      </Style>
    </Style>

    <!-- Warm Folder Icon for Groups -->
    <Style Selector="ToggleButton.folder">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <Path x:Name="ChevronPath"
                  Data="{StaticResource Icons.Folder}"
                  Fill="#E5A824"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Path#ChevronPath">
        <Setter Property="Data" Value="{StaticResource Icons.Folder.Open}" />
      </Style>
    </Style>
  </UserControl.Styles>

  <!-- Centered Layout Container -->
  <Grid RowDefinitions="Auto,*,Auto" MaxWidth="1040" Margin="24,16,24,16">
    <!-- Top: Search Bar -->
    <Border Grid.Row="0" Margin="0,0,0,12">
      <TextBox x:Name="SearchBox"
               Height="32"
               Padding="36,0,70,0"
               CornerRadius="16"
               BorderBrush="{DynamicResource Brush.Border0}"
               BorderThickness="1"
               Background="{DynamicResource Brush.Contents}"
               Watermark="{DynamicResource Text.Welcome.Search}"
               VerticalContentAlignment="Center"
               FontSize="13"
               Text="{Binding SearchFilter, Mode=TwoWay}">
        <TextBox.Styles>
          <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border0}"/>
          </Style>
          <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
          </Style>
        </TextBox.Styles>

        <TextBox.InnerLeftContent>
          <Path Width="14" Height="14" Margin="12,0,0,0" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
        </TextBox.InnerLeftContent>

        <TextBox.InnerRightContent>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Spacing="4">
            <!-- Invisible Button to handle search hotkey pressed-->
            <Button Width="0" Height="0"
                    Margin="0" Padding="0"
                    Click="OnSearchHotKey"
                    HotKey="{OnPlatform Ctrl+F, macOS=⌘+F}"/>

            <Button Classes="icon_button"
                    Width="24" Height="24"
                    IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Click="OnClearSearchFilter"
                    ToolTip.Tip="Clear">
              <Path Width="10" Height="10" Data="{StaticResource Icons.Clear}" Fill="{DynamicResource Brush.FG2}"/>
            </Button>

            <!-- Keyboard Shortcut Pill -->
            <Border Background="{DynamicResource Brush.FlatButton.BackgroundHovered}"
                    CornerRadius="8"
                    Padding="6,2"
                    IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                    IsHitTestVisible="False">
              <TextBlock Text="{OnPlatform Ctrl+F, macOS=⌘F}"
                         FontSize="10"
                         FontFamily="{DynamicResource Fonts.Monospace}"
                         Foreground="{DynamicResource Brush.FG2}"/>
            </Border>
          </StackPanel>
        </TextBox.InnerRightContent>
      </TextBox>
    </Border>

    <!-- Center: Elevated Card Container for Repositories -->
    <Border Grid.Row="1"
            Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Border0}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
      <Grid>
        <!-- Managed Repositories ListBox -->
        <v:RepositoryListBox x:Name="TreeContainer"
                             Padding="6,6"
                             Focusable="True"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding Rows}"
                             SelectionMode="Single"
                             LostFocus="OnTreeViewLostFocus"
                             DragDrop.AllowDrop="True"
                             DragDrop.DragOver="DragOverTreeView"
                             DragDrop.Drop="DropOnTreeView">
          <ListBox.Styles>
            <Style Selector="ListBox">
              <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                  <Border Background="Transparent" BorderThickness="0"/>
                </FocusAdornerTemplate>
              </Setter>
            </Style>

            <Style Selector="ListBoxItem" x:DataType="vm:RepositoryNode">
              <Setter Property="Margin" Value="0,1"/>
              <Setter Property="Padding" Value="6,0"/>
              <Setter Property="MinHeight" Value="36"/>
              <Setter Property="CornerRadius" Value="6"/>
              <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                  <Border Background="Transparent" BorderThickness="0"/>
                </FocusAdornerTemplate>
              </Setter>
            </Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
            </Style>
          </ListBox.Styles>

          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>

          <!-- ListBox Background Context Menu -->
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{DynamicResource Text.Welcome.Clone}" Command="{Binding Clone}">
                <MenuItem.Icon>
                  <Path Width="12" Height="12" Data="{DynamicResource Icons.Clone}"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource Text.Welcome.OpenOrInit}" Command="{Binding OpenLocalRepository}">
                <MenuItem.Icon>
                  <Path Width="12" Height="12" Data="{DynamicResource Icons.Folder.Open}"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="-" />
              <MenuItem Header="{DynamicResource Text.Welcome.AddRootFolder}" Command="{Binding AddRootNode}">
                <MenuItem.Icon>
                  <Path Width="12" Height="12" Data="{DynamicResource Icons.Folder.Add}"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource Text.ScanRepositories}" Command="{Binding ScanDefaultCloneDir}">
                <MenuItem.Icon>
                  <Path Width="12" Height="12" Data="{DynamicResource Icons.Scan}"/>
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>

          <!-- Repository / Folder Item Template -->
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:RepositoryNode">
              <Grid Background="Transparent"
                    MinHeight="36"
                    ColumnDefinitions="20,24,*,Auto,8"
                    Margin="{Binding Depth, Converter={x:Static c:IntConverters.ToTreeMargin}}"
                    ClipToBounds="True"
                    ContextRequested="OnTreeNodeContextRequested"
                    PointerPressed="OnPointerPressedTreeNode"
                    PointerMoved="OnPointerMovedOverTreeNode"
                    PointerReleased="OnPointerReleasedOnTreeNode"
                    DoubleTapped="OnDoubleTappedTreeNode"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="DragOverTreeNode"
                    DragDrop.Drop="DropOnTreeNode">

                <!-- Tree Expander (Folders Only) -->
                <v:RepositoryTreeNodeToggleButton Grid.Column="0"
                                                  Classes="tree_expander"
                                                  Focusable="False"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                                  IsVisible="{Binding !IsRepository}"/>

                <!-- Repository / Bookmark Icon -->
                <v:Bookmark Grid.Column="1"
                            Width="14" Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Value="{Binding Bookmark, Mode=OneWay}"
                            IsVisible="{Binding IsRepository}"/>

                <!-- Folder Icon (Folders Only) -->
                <ToggleButton Grid.Column="1"
                              Classes="folder"
                              Focusable="False"
                              Width="16" Height="16"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsExpanded}"
                              IsVisible="{Binding !IsRepository}"/>

                <!-- Details (Name, Path, Badges) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" ClipToBounds="True">
                  <TextBlock VerticalAlignment="Center"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.FG1}"
                             Text="{Binding Name}"/>

                  <!-- Folder Children Count Pill -->
                  <Border Background="{DynamicResource Brush.FlatButton.BackgroundHovered}"
                          CornerRadius="8"
                          Padding="6,1"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          IsVisible="{Binding !IsRepository}">
                    <TextBlock Text="{Binding SubNodes.Count}"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.FG2}"/>
                  </Border>

                  <!-- Repository Relative Path -->
                  <TextBlock Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             FontSize="12"
                             Foreground="{DynamicResource Brush.FG2}"
                             Text="{Binding Id, StringFormat=({0}), Converter={x:Static c:PathConverters.RelativeToHome}}">
                    <TextBlock.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsRepository"/>
                        <Binding Path="IsInvalid" Converter="{x:Static BoolConverters.Not}"/>
                      </MultiBinding>
                    </TextBlock.IsVisible>
                  </TextBlock>

                  <!-- Missing Directory Warning Icon -->
                  <Path Margin="6,0,0,0"
                        Width="13" Height="13"
                        Data="{StaticResource Icons.Error}"
                        Fill="OrangeRed"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Directory does not exist"
                        IsVisible="{Binding IsInvalid}"/>
                </StackPanel>

                <!-- Status Badges -->
                <ContentControl Grid.Column="3"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Content="{Binding Status, Mode=OneWay}"
                                IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <ContentControl.DataTemplates>
                    <DataTemplate DataType="m:RepositoryStatus">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Local Changes Badge -->
                        <Border Margin="3,0"
                                Height="20"
                                CornerRadius="10"
                                Padding="8,0"
                                Background="{DynamicResource Brush.Badge}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding LocalChanges, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                          <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="±"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.BadgeFG}"/>
                            <TextBlock Text="{Binding LocalChanges}"
                                       FontFamily="{DynamicResource Fonts.Monospace}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.BadgeFG}"/>
                          </StackPanel>
                        </Border>

                        <!-- Tracking Status (ahead / behind) -->
                        <TextBlock Margin="4,0"
                                   Text="{Binding TrackingDescription}"
                                   FontFamily="{DynamicResource Fonts.Monospace}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.FG2}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsTrackingStatusVisible}"/>

                        <!-- Current Branch Pill Badge -->
                        <Border Margin="4,0,0,0"
                                Background="{DynamicResource Brush.FlatButton.BackgroundHovered}"
                                BorderBrush="{DynamicResource Brush.Border0}"
                                BorderThickness="1"
                                Height="22"
                                CornerRadius="11"
                                Padding="8,0"
                                VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                            <Path Width="11" Height="11" Data="{StaticResource Icons.Branch}" Fill="{DynamicResource Brush.FG2}"/>
                            <TextBlock Margin="2,0,0,0"
                                       Text="{Binding CurrentBranch}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Brush.FG1}"/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </v:RepositoryListBox>

        <!-- Empty State (When Rows.Count == 0) -->
        <Grid IsVisible="{Binding !Rows.Count}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="32"
              IsHitTestVisible="True"
              DragDrop.AllowDrop="True"
              DragDrop.DragOver="DragOverTreeView"
              DragDrop.Drop="DropOnTreeView">
          <!-- When searching and no results -->
          <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="12"
                      IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Path Width="36" Height="36" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}" HorizontalAlignment="Center" Opacity="0.5"/>
            <TextBlock Text="{DynamicResource Text.Welcome.NoMatches}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.FG1}"/>
            <Button Classes="flat primary" Height="28" Padding="14,0" HorizontalAlignment="Center" Click="OnClearSearchFilter">
              <TextBlock Text="{DynamicResource Text.Welcome.ClearSearch}" FontSize="12"/>
            </Button>
          </StackPanel>

          <!-- First run / No repositories configured -->
          <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="12"
                      IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNullOrEmpty}}">
            <Path Width="44" Height="44" Data="{StaticResource Icons.Repositories}" Fill="{DynamicResource Brush.FG2}" HorizontalAlignment="Center" Opacity="0.4"/>
            <TextBlock Text="{DynamicResource Text.Welcome.NoRepositories}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.FG1}"/>
            <TextBlock Text="{DynamicResource Text.Welcome.NoRepositoriesDesc}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
              <Button Classes="flat primary" Height="30" Padding="14,0" Command="{Binding Clone}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path Width="13" Height="13" Data="{StaticResource Icons.Clone}" Fill="White"/>
                  <TextBlock Text="{DynamicResource Text.Welcome.Clone}" FontSize="12"/>
                </StackPanel>
              </Button>
              <Button Classes="flat" Height="30" Padding="14,0" Command="{Binding OpenLocalRepository}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path Width="13" Height="13" Data="{StaticResource Icons.Folder.Open}"/>
                  <TextBlock Text="{DynamicResource Text.Welcome.OpenOrInit}" FontSize="12"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Bottom: Fluent 2 Footer Hints Card -->
    <Border Grid.Row="2"
            Margin="0,12,0,0"
            Background="{DynamicResource Brush.SubPanel}"
            BorderBrush="{DynamicResource Brush.Border0}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14,9"
            HorizontalAlignment="Stretch"
            IsVisible="{OnPlatform True, Linux=False}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Info}" Fill="{DynamicResource Brush.FG2}"/>
          <TextBlock FontSize="12" Foreground="{DynamicResource Brush.FG2}" VerticalAlignment="Center"
                     Text="{DynamicResource Text.Welcome.DragDropTip}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Border Background="{DynamicResource Brush.FlatButton.BackgroundHovered}" CornerRadius="3" Padding="4,1">
              <TextBlock Text="Enter" FontSize="10" FontFamily="{DynamicResource Fonts.Monospace}" Foreground="{DynamicResource Brush.FG2}"/>
            </Border>
            <TextBlock Text="{DynamicResource Text.Welcome.OpenHint}" FontSize="11" Foreground="{DynamicResource Brush.FG2}" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Border Background="{DynamicResource Brush.FlatButton.BackgroundHovered}" CornerRadius="3" Padding="4,1">
              <TextBlock Text="{OnPlatform Delete, macOS=⌫}" FontSize="10" FontFamily="{DynamicResource Fonts.Monospace}" Foreground="{DynamicResource Brush.FG2}"/>
            </Border>
            <TextBlock Text="{DynamicResource Text.Welcome.DeleteHint}" FontSize="11" Foreground="{DynamicResource Brush.FG2}" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
