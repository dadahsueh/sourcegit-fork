<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="38"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Styles>
    <Style Selector="Button.fluent_command">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.fluent_command:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
    </Style>
    <Style Selector="Button.fluent_command:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.Background}"/>
    </Style>
    <Style Selector="Button.fluent_command TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.fluent_command Path">
      <Setter Property="Fill" Value="{DynamicResource Brush.FG1}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon_button">
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.icon_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
    </Style>
    <Style Selector="Button.icon_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.Background}"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*,Auto" Height="38" Margin="8,0,8,0">
    <!-- Left: Primary Git Actions with Distinct Icons + Text Labels followed by unrolled secondary actions -->
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
      <!-- 1. Fetch -->
      <Button Classes="fluent_command" Tapped="Fetch">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Fetch}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Fetch}"/>
          <TextBlock Text="{DynamicResource Text.Fetch}"/>
        </StackPanel>
      </Button>

      <!-- 2. Pull (with incoming indicator) -->
      <Button Classes="fluent_command" Tapped="Pull" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Pull}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Grid Width="16" Height="16">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Pull}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="6" Height="6"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="#107C41"
                     IsVisible="{Binding CurrentBranch?.Behind, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Text="{DynamicResource Text.Pull}"/>
        </StackPanel>
      </Button>

      <!-- 3. Push (with outgoing indicator) -->
      <Button Classes="fluent_command" Tapped="Push">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Push}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Grid Width="16" Height="16">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Push}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="6" Height="6"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="#107C41"
                     IsVisible="{Binding CurrentBranch?.Ahead, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Text="{DynamicResource Text.Push}"/>
        </StackPanel>
      </Button>

      <!-- Divider -->
      <Rectangle Width="1" Height="18" Margin="4,0" Fill="{DynamicResource Brush.Border0}" VerticalAlignment="Center"/>

      <!-- 4. Branch -->
      <Button Classes="fluent_command" Command="{Binding CreateNewBranch}" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Repository.NewBranch}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+B, macOS=⌘+B}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Branch.Add}"/>
          <TextBlock Text="{DynamicResource Text.Repository.NewBranch}"/>
        </StackPanel>
      </Button>

      <!-- 5. Stash -->
      <Button Classes="fluent_command" Tapped="StashAll" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Stash}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Stashes.Add}"/>
          <TextBlock Text="{DynamicResource Text.Stash}"/>
        </StackPanel>
      </Button>

      <!-- Divider -->
      <Rectangle Width="1" Height="18" Margin="4,0" Fill="{DynamicResource Brush.Border0}" VerticalAlignment="Center"/>

      <!-- Secondary Operations: Directly visible as compact icon buttons (No ... sub-menu) -->
      <!-- Apply Patch -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Command="{Binding ApplyPatch}" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Apply.Title}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.ApplyPatch}"/>
      </Button>

      <!-- Git Flow -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Click="OpenGitFlowMenu" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.GitFlow}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.GitFlow}"/>
      </Button>

      <!-- Git LFS -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Click="OpenGitLFSMenu" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.GitLFS}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.LFS}"/>
      </Button>

      <!-- Bisect -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Click="StartBisect" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Bisect}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Bisect}"/>
      </Button>

      <!-- Clean -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Click="Cleanup" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Repository.Clean}">
        <Path Width="14" Height="14" Margin="0,1,0,0" Data="{StaticResource Icons.Clean}"/>
      </Button>

      <!-- Divider -->
      <Rectangle Width="1" Height="18" Margin="4,0" Fill="{DynamicResource Brush.Border0}" VerticalAlignment="Center"/>

      <!-- Logs -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Click="OpenGitLogs" ToolTip.Tip="{DynamicResource Text.Repository.ViewLogs}">
        <Path Width="14" Height="14" Margin="0,1,0,0" Data="{StaticResource Icons.Logs}"/>
      </Button>

      <!-- Statistics -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Click="OpenStatistics" ToolTip.Tip="{DynamicResource Text.Repository.Statistics}">
        <Path Width="13" Height="13" Margin="0,1.5,0,0" Data="{StaticResource Icons.Statistics}"/>
      </Button>

      <!-- Custom Actions -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Click="OpenCustomActionMenu" ToolTip.Tip="{DynamicResource Text.Repository.CustomActions}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Action}"/>
      </Button>
    </StackPanel>

    <!-- Hidden HotKey Triggers -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="False">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>

    <!-- Right: Current Branch Navigator and Primary Utilities -->
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
      <!-- Active Branch Indicator / Navigate to Head -->
      <Button Classes="fluent_command" Click="NavigateToHead" ToolTip.Tip="{DynamicResource Text.Repository.NavigateToCurrentHead}">
        <Border Padding="6,2" CornerRadius="4" Background="{DynamicResource Brush.SubPanel}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border0}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Branch}" Fill="{DynamicResource Brush.FG1}"/>
            <TextBlock Text="{Binding CurrentBranch.Name, TargetNullValue='--', Mode=OneWay}"
                       FontWeight="SemiBold"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.FG1}"/>
            <Path Width="10" Height="10" Data="{StaticResource Icons.Target}" Fill="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </Border>
      </Button>

      <!-- Terminal -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Click="OpenTerminal" ToolTip.Tip="{DynamicResource Text.Repository.Terminal}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Terminal}"/>
      </Button>

      <!-- File Manager (Finder/Explorer) -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Click="OpenInFileManager" ToolTip.Tip="{DynamicResource Text.Repository.Explore}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Explore}"/>
      </Button>

      <!-- Repository Configure / Settings -->
      <Button Classes="icon_button" Width="28" Height="28" Padding="0" Click="OpenConfigure" ToolTip.Tip="{DynamicResource Text.Repository.Configure}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Settings}"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
